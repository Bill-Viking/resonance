{
  "manifest_version": 3,
  "name": "Resonance Reader",
  "version": "0.1.0",
  "description": "Reads your own recent X posts and YouTube comments when you click Check now in Resonance on this computer. Read-only.",
  "minimum_chrome_version": "106",
  "incognito": "not_allowed",
  "icons": {"16": "icon-16.png", "32": "icon-32.png", "128": "icon-128.png"},
  "permissions": ["scripting"],
  "host_permissions": ["http://127.0.0.1:4317/*"],
  "optional_host_permissions": [
    "https://x.com/*",
    "https://www.youtube.com/*",
    "https://myactivity.google.com/*"
  ],
  "action": {
    "default_title": "Resonance Reader",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:4317/"],
      "js": ["shared.js", "bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
